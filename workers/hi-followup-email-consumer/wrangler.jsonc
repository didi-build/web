{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hi-followup-email-consumer",
  "main": "index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": {
    "LEAD_NOTIFY_TO": "diadem@didi.build",
  },
  "queues": {
    "consumers": [
      {
        "queue": "hi-followup-email",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "retry_delay": 30,
      },
    ],
  },
}
