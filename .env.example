# Anthropic (server only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Linear (server only)
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
LINEAR_LEAD_LABEL_ID=

# Gmail (server only; service account with domain-wide delegation)
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_SENDER=diadem@didi.build
LEAD_EMAIL_TO=hello@didi.build

# Cloudflare Turnstile (contact form + visibility checker)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public /book redirect target (server only; also set in wrangler.jsonc vars for production)
BOOKING_URL=https://diadem-shoukralla.moxieapp.com/public/diadem-shoukralla/free-30-min-consult

# Local OpenNext / Wrangler (optional)
NEXTJS_ENV=development
