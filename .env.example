# Anthropic (server only; visibility checker explainer)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Linear (server only; /hi card leads)
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_PROJECT_ID=
LINEAR_LEAD_LABEL_ID=

# Gmail (hi-followup-email-consumer Worker only; sends /hi vCard follow-up)
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_SENDER=diadem@didi.build

# Signed token for /hi details step (server only)
HI_TOKEN_SECRET=

# Cloudflare Turnstile (visibility checker + /hi exchange)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public /book redirect target (server only; also set in wrangler.jsonc vars for production)
BOOKING_URL=https://portal.didi.build/public/free-30-min-consult

# Local OpenNext / Wrangler (optional)
NEXTJS_ENV=development
